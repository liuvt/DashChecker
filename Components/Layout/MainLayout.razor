@inherits LayoutComponentBase
@inject SkySoftReportService SkySoft
@inject SkySoftLinkService LinkService
@inject AliService Ali
@inject AliWorkerService AliWorker
@inject AppSessionService Session
@inject NavigationManager Navigation
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-root app-with-sidebar">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
            </div>
            <div>
                <strong>DashChecker</strong>
                <small>Hệ thống điều hành &amp; đối soát</small>
            </div>
        </div>

        <section class="sidebar-account">
            <div class="sidebar-connected-header">
                <span class="account-caption" style="margin:0">TÀI KHOẢN ĐANG KẾT NỐI</span>
                <span class="connected-total-pill @(TotalConnectedCount > 0 ? "online" : "offline")">
                    <span class="status-dot @(TotalConnectedCount > 0 ? "pulse" : "")"></span>
                    @TotalConnectedCount TK
                </span>
            </div>

            <!-- 1. Nhóm tài khoản SkySoft đang kết nối -->
            <div class="sidebar-provider-group">
                <div class="sidebar-provider-label">
                    <span>SKYSOFT KHU VỰC</span>
                    <small>@_connectedAccounts.Count/@_allAccounts.Count</small>
                </div>

                @if (_connectedAccounts.Count > 0)
                {
                    <div class="sidebar-connected-list">
                        @foreach (var item in _connectedAccounts)
                        {
                            var active = Session.Area is not null &&
                                         string.Equals(Session.Area.AreaCode, item.AreaCode, StringComparison.OrdinalIgnoreCase);
                            var displayUser = !string.IsNullOrWhiteSpace(item.UserName) ? item.UserName : item.ApiUserName;

                            <button type="button"
                                    class="sidebar-connected-card @(active ? "active" : "")"
                                    @onclick="() => SwitchActiveArea(item)"
                                    title="Bấm để chuyển khu vực làm việc sang @item.AreaName (@item.AreaCode)">
                                <span class="account-area-code">@item.AreaCode</span>
                                <div class="sidebar-connected-meta">
                                    <strong>@item.AreaName</strong>
                                    <small>@displayUser</small>
                                </div>
                                <div class="sidebar-connected-right">
                                    <span class="status-dot pulse" title="Đang kết nối"></span>
                                    @if (active)
                                    {
                                        <span class="active-area-tag">Đang chọn</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="sidebar-empty-connect">
                        <span>Chưa có tài khoản SkySoft nào Connect</span>
                        @if (_allAccounts.Count > 0)
                        {
                            <div class="sidebar-area-switcher">
                                @foreach (var item in _allAccounts)
                                {
                                    var active = Session.Area is not null &&
                                                 string.Equals(Session.Area.AreaCode, item.AreaCode, StringComparison.OrdinalIgnoreCase);
                                    <button type="button"
                                            class="area-switch-chip @(active ? "active" : "")"
                                            @onclick="() => SwitchActiveArea(item)"
                                            title="Chọn khu vực @item.AreaName">
                                        @item.AreaCode
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 2. Nhóm tài khoản Ali (Module tích hợp Ali) -->
            <div class="sidebar-provider-group">
                <div class="sidebar-provider-label">
                    <span>ALI • MODULE TÍCH HỢP</span>
                    <small>@(Ali.IsConnected ? "Connected" : "Offline")</small>
                </div>

                @if (Ali.IsConnected)
                {
                    <button type="button"
                            class="sidebar-connected-card ali-card"
                            @onclick='() => Navigation.NavigateTo("/ali-schedule")'
                            title="Đã đăng nhập Ali tại mục Liên kết — Bấm để mở Chạy Ali (Hẹn giờ)">
                        <span class="account-area-code ali-code">ALI</span>
                        <div class="sidebar-connected-meta">
                            <strong>@(string.IsNullOrWhiteSpace(Ali.ConnectedUserName) ? "Ali Admin" : Ali.ConnectedUserName)</strong>
                            <small>admin.nhaxeviet.vn · @Ali.CookieCount cookie</small>
                        </div>
                        <div class="sidebar-connected-right">
                            <span class="status-dot pulse"></span>
                            <span class="active-area-tag ali-tag">Đã liên kết</span>
                        </div>
                    </button>
                }
                else
                {
                    <div class="sidebar-empty-connect">
                        <span>Chưa kết nối tài khoản Ali</span>
                    </div>
                }
            </div>

            <NavLink class="btn sidebar-manage-links-btn" href="/link-management">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
                <span>Cấu hình Tài khoản Liên kết</span>
            </NavLink>
        </section>

        <nav class="side-nav">
            <div class="nav-section-label">CUỐC XE &amp; DOANH THU</div>
            <NavLink href="/" Match="NavLinkMatch.All" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
                <span>Báo cáo đồng hồ</span>
            </NavLink>
            <NavLink href="/app-trips" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                </span>
                <span>Báo cáo cuốc khách</span>
            </NavLink>

            <div class="nav-section-label">VẬN HÀNH &amp; LIÊN KẾT</div>
            <NavLink href="/shift-management" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span>Quản lý lên xuống ca</span>
            </NavLink>
            <NavLink href="/online-vehicles" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="3 11 22 2 13 21 11 13 3 11" />
                    </svg>
                </span>
                <span>GPS Online</span>
            </NavLink>
            <NavLink href="/ali-schedule" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
                <span>Chạy Ali (Hẹn giờ)</span>
                @if (AliWorker.IsRunning)
                {
                    <span class="nav-badge" title="Hẹn giờ tự động 1 lần/ngày đang chạy">AUTO</span>
                }
            </NavLink>
            <NavLink href="/link-management" class="side-nav-item">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                </span>
                <span>Quản lý Liên kết</span>
                @if (TotalConnectedCount > 0)
                {
                    <span class="nav-badge">@TotalConnectedCount</span>
                }
            </NavLink>

            <div class="nav-section-label">QUẢN LÝ ĐỐI SOÁT APP</div>
            <NavLink href="/app-management" Match="NavLinkMatch.All" class="side-nav-item app-nav-parent">
                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                    </svg>
                </span>
                <span>Tổng quan Quản lý App</span>
            </NavLink>
            <NavLink href="/app-management/customer-app" class="side-nav-item app-nav-item">
                <span class="nav-icon">📱</span>
                <span>App Khách Hàng</span>
            </NavLink>
            <NavLink href="/app-management/customer-promo" class="side-nav-item app-nav-item">
                <span class="nav-icon">🏷️</span><span>Khuyến mãi App KH</span>
            </NavLink>
            <NavLink href="/app-management/vnpay" class="side-nav-item app-nav-item">
                <span class="nav-icon">💳</span><span>App VNPay</span>
            </NavLink>
            <NavLink href="/app-management/xanh-sm" class="side-nav-item app-nav-item">
                <span class="nav-icon">🚕</span><span>App Xanh SM</span>
            </NavLink>
            <NavLink href="/app-management/contracts" class="side-nav-item app-nav-item">
                <span class="nav-icon">📑</span><span>Hợp đồng</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <span>DashChecker Enterprise</span>
            <span>.NET 9.0 · Blazor Server</span>
        </div>
    </aside>

    <div class="app-content">
        <header class="content-topbar">
            <div class="topbar-breadcrumb">
                <span class="breadcrumb-cat">@CurrentCategory</span>
                <span class="breadcrumb-sep">/</span>
                <strong>@CurrentTitle</strong>
                @if (Session.Area is not null)
                {
                    <span class="topbar-area-tag">@Session.Area.AreaCode · @Session.Area.AreaName</span>
                }
            </div>
            <div class="topbar-right">
                <div class="topbar-shift-clock" title="Khung giờ vận hành tiêu chuẩn">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span>Ca vận hành: 05:00:00 → 05:00:00</span>
                </div>
                <div class="content-status @(TotalConnectedCount > 0 ? "online" : "offline")">
                    <span class="status-dot @(TotalConnectedCount > 0 ? "pulse" : "")"></span>
                    <span>SkySoft: @_connectedAccounts.Count TK · Ali: @(Ali.IsConnected ? "Connected" : "Offline")</span>
                </div>
            </div>
        </header>
        <main>@Body</main>
    </div>
</div>

@code {
    private IReadOnlyList<SkySoftLinkAccountView> _allAccounts = [];
    private IReadOnlyList<SkySoftLinkAccountView> _connectedAccounts = [];

    private int TotalConnectedCount => _connectedAccounts.Count + (Ali.IsConnected ? 1 : 0);

    private string CurrentCategory
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (path.StartsWith("app-management", StringComparison.OrdinalIgnoreCase))
                return "Quản lý App";
            if (path is "shift-management" or "online-vehicles" or "online-app" or "link-management" or "ali-schedule")
                return "Vận hành & Liên kết";
            return "Cuốc xe";
        }
    }

    private string CurrentTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            if (path.StartsWith("app-management/", StringComparison.OrdinalIgnoreCase))
            {
                var moduleKey = path.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
                return AppModuleDefinition.Get(moduleKey).Title;
            }

            return path switch
            {
                "app-management" => "Quản lý App",
                "shift-management" => "Quản lý lên xuống ca",
                "online-vehicles" => "GPS Online",
                "ali-schedule" => "Chạy Ali (Hẹn giờ)",
                "link-management" => "Quản lý Liên kết",
                "app-trips" => "Báo cáo cuốc khách",
                "online-app" => "Online App",
                _ => "Báo cáo đồng hồ"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        LinkService.Changed += OnLinkChanged;
        Ali.AuthChanged += OnAliAuthChanged;
        AliWorker.StatusChanged += OnWorkerChanged;
        Navigation.LocationChanged += OnLocationChanged;

        await Ali.LoadAuthenticationAsync();
        await RefreshConnectedAccountsAsync();
    }

    private async Task RefreshConnectedAccountsAsync()
    {
        _allAccounts = await LinkService.GetAccountsAsync();
        _connectedAccounts = _allAccounts.Where(x => x.IsConnected).ToList();

        // Tự động gán khu vực làm việc từ tài khoản đang kết nối (hoặc tài khoản cấu hình đầu tiên)
        if (!Session.IsLoggedIn || Session.Area is null)
        {
            var target = _connectedAccounts.FirstOrDefault() ?? _allAccounts.FirstOrDefault();
            if (target is not null)
            {
                var user = !string.IsNullOrWhiteSpace(target.UserName) ? target.UserName : target.ApiUserName;
                Session.SetLoggedIn(user, new AreaContext(user, target.AreaCode, target.AreaName));
            }
        }
    }

    private void SwitchActiveArea(SkySoftLinkAccountView item)
    {
        var user = !string.IsNullOrWhiteSpace(item.UserName) ? item.UserName : item.ApiUserName;
        SkySoft.Logout();
        Session.SetLoggedIn(user, new AreaContext(user, item.AreaCode, item.AreaName));
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLinkChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshConnectedAccountsAsync();
        StateHasChanged();
    });
    private void OnAliAuthChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    private void OnWorkerChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        LinkService.Changed -= OnLinkChanged;
        Ali.AuthChanged -= OnAliAuthChanged;
        AliWorker.StatusChanged -= OnWorkerChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

