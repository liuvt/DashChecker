                    </div>
                </div>

                <div class="confirm-actions">
                    <button class="btn secondary" @onclick="CloseEditor" disabled="@_savingEditor">Hủy</button>
                    <button class="btn save" @onclick="SaveEditorAsync" disabled="@_savingEditor">
                        @if (_savingEditor) { <span class="spinner"></span><span>Đang lưu...</span> }
                        else { <span>✓ Lưu cấu hình liên kết</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _activeTab = "all";
    private IReadOnlyList<SkySoftLinkAccountView> _accounts = [];
    private SharedVehicleRegistryPage? _registryPage;
    private SharedVehicleFetchSummary? _lastFetchSummary;

    private AliUser _aliUser = new();
    private bool _showAliPassword;
    private bool _connectingAli;
    private string _selectedPresetKey = "05:05:00";

    private string _vehicleSearch = string.Empty;
    private string _filterMode = "all";
    private string _areaFilter = string.Empty;
    private int _vehiclePage = 1;

    private bool _loading;
    private bool _fetchingShared;
    private bool _savingEditor;
    private bool _showEditor;
    private int? _connectingAccountId;
    private SkySoftLinkEditModel _editor = SkySoftLinkEditModel.CreateNew();
    private readonly Dictionary<int, string> _quickPasswords = new();

    private string? _message;
    private string? _error;

    private bool _busy => _loading || _fetchingShared || _savingEditor || _connectingAccountId.HasValue || _connectingAli;

    protected override async Task OnInitializedAsync()
    {
        _selectedPresetKey = AliWorker.SelectedPresetKey;
        LinkService.Changed += OnLinkServiceChanged;
        Ali.AuthChanged += OnAliAuthChanged;
        AliWorker.StatusChanged += OnWorkerChanged;
        await ReloadAllAsync();
    }

    private void OnLinkServiceChanged() => _ = InvokeAsync(async () =>
    {
        _accounts = await LinkService.GetAccountsAsync();
        StateHasChanged();
    });

    private void OnAliAuthChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnWorkerChanged() => _ = InvokeAsync(() =>
    {
        _selectedPresetKey = AliWorker.SelectedPresetKey;
        StateHasChanged();
    });

    private void OnPresetTimeChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(key))
        {
            _selectedPresetKey = key;
            AliWorker.SelectPreset(key);
        }
    }

    private void StartDailyWorker()
    {
        AliWorker.Start(_selectedPresetKey);
        _message = $"Đã bật hẹn giờ tự động 1 lần/ngày theo mốc {_selectedPresetKey} (chỉ gọi API & lưu vào 7 bảng SQLite cục bộ, không tự ý đẩy Google Sheet).";
    }

    private void StopDailyWorker()
    {
        AliWorker.Stop();
        _message = "Đã dừng tiến trình hẹn giờ tự động.";
    }

    private async Task ReloadAllAsync()
    {
        _loading = true;
        try
        {
            _accounts = await LinkService.GetAccountsAsync();
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);

            var aliSchema = await Ali.LoadAuthenticationAsync();
            if (aliSchema?.User is not null)
            {
                _aliUser = new AliUser
                {
                    username = aliSchema.User.username,
                    password = aliSchema.User.password
                };
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SwitchTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab == "vehicles")
        {
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
        }
    }

    private async Task ConnectAliAsync()
    {
        _message = _error = null;
        _connectingAli = true;
        try
        {
            var ok = await Ali.AuthenticateAsync(_aliUser);
            if (ok)
            {
                _message = $"Đã kết nối thành công tài khoản Ali ({_aliUser.username}) trên admin.nhaxeviet.vn ({Ali.CookieCount} cookie phiên). Các màn hình App Khách Hàng đã sẵn sàng sử dụng.";
            }
            else
            {
                _error = "Xác thực tài khoản Ali thất bại: Sai tài khoản hoặc mật khẩu trên admin.nhaxeviet.vn.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Lỗi kết nối Ali: {ex.Message}";
        }
        finally
        {
            _connectingAli = false;
        }
    }

    private void DisconnectAli()
    {
        _message = _error = null;
        Ali.Disconnect();
        _message = "Đã ngắt kết nối phiên Tài khoản Ali.";
    }

    private void BeginAddAccount()
    {
        _editor = SkySoftLinkEditModel.CreateNew();
        _showEditor = true;
        _message = _error = null;
    }

    private void BeginEditAccount(SkySoftLinkAccountView acc)
    {
        _editor = SkySoftLinkEditModel.FromView(acc);
        _showEditor = true;
        _message = _error = null;
    }

    private void CloseEditor()
    {
        if (_savingEditor) return;
        _showEditor = false;
    }

    private async Task SaveEditorAsync()
    {
        _message = _error = null;
        _savingEditor = true;
        try
        {
            await LinkService.SaveAccountAsync(_editor);
            _showEditor = false;
            await ReloadAllAsync();
            _message = $"Đã lưu cấu hình liên kết khu vực {_editor.AreaName} ({_editor.AreaCode}).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingEditor = false;
        }
    }

    private async Task DeleteAccountAsync(SkySoftLinkAccountView acc)
    {
        _message = _error = null;
        try
        {
            await LinkService.DeleteAccountAsync(acc.Id);
            await ReloadAllAsync();
            _message = $"Đã xóa liên kết {acc.AreaName} ({acc.AreaCode}).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ConnectOneAsync(SkySoftLinkAccountView acc)
    {
        _message = _error = null;
        _connectingAccountId = acc.Id;
        try
        {
            var pwdOverride = GetQuickPassword(acc.Id);
            var connected = await LinkService.ConnectAccountAsync(acc.Id, pwdOverride);
            _quickPasswords.Remove(acc.Id);

            Session.SetLoggedIn(
                string.IsNullOrWhiteSpace(connected.UserName) ? connected.ApiUserName : connected.UserName,
                new AreaContext(
                    string.IsNullOrWhiteSpace(connected.UserName) ? connected.ApiUserName : connected.UserName,
                    connected.AreaCode,
                    connected.AreaName));

            await ReloadAllAsync();
            _message = $"Đã kết nối thành công {connected.AreaName} ({connected.AreaCode}): {connected.LastStatusMessage}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _connectingAccountId = null;
        }
    }

    private async Task DisconnectOneAsync(SkySoftLinkAccountView acc)
    {
        _message = _error = null;
        _connectingAccountId = acc.Id;
        try
        {
            await LinkService.DisconnectAccountAsync(acc.Id);
            await ReloadAllAsync();
            _message = $"Đã ngắt kết nối tài khoản {acc.AreaName} ({acc.AreaCode}).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _connectingAccountId = null;
        }
    }

    private async Task ConnectAllAsync()
    {
        _message = _error = null;
        _loading = true;
        try
        {
            var count = await LinkService.ConnectAllAvailableAsync();

            var aliConnectedMsg = string.Empty;
            if (!Ali.IsConnected && !string.IsNullOrWhiteSpace(_aliUser.username) && !string.IsNullOrWhiteSpace(_aliUser.password))
            {
                try
                {
                    if (await Ali.AuthenticateAsync(_aliUser))
                        aliConnectedMsg = " + Tài khoản Ali";
                }
                catch
                {
                    // Bỏ qua lỗi phụ khi kết nối nhanh tất cả
                }
            }
            else if (Ali.IsConnected)
            {
                aliConnectedMsg = " + Tài khoản Ali (đã kết nối)";
            }

            await ReloadAllAsync();

            var firstConnected = _accounts.FirstOrDefault(x => x.IsConnected);
            if (firstConnected is not null && !Session.IsLoggedIn)
            {
                Session.SetLoggedIn(
                    string.IsNullOrWhiteSpace(firstConnected.UserName) ? firstConnected.ApiUserName : firstConnected.UserName,
                    new AreaContext(
                        string.IsNullOrWhiteSpace(firstConnected.UserName) ? firstConnected.ApiUserName : firstConnected.UserName,
                        firstConnected.AreaCode,
                        firstConnected.AreaName));
            }

            _message = $"Đã kết nối {count:N0} tài khoản SkySoft{aliConnectedMsg}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DisconnectAllAsync()
    {
        _message = _error = null;
        _loading = true;
        try
        {
            await LinkService.DisconnectAllAsync();
            Ali.Disconnect();
            await ReloadAllAsync();
            _message = "Đã ngắt kết nối toàn bộ tài khoản SkySoft và Ali.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ActivateAreaSession(SkySoftLinkAccountView acc)
    {
        var user = !string.IsNullOrWhiteSpace(acc.UserName) ? acc.UserName : acc.ApiUserName;
        Session.SetLoggedIn(user, new AreaContext(user, acc.AreaCode, acc.AreaName));
        _message = $"Đã chuyển khu vực làm việc sang {acc.AreaName} ({acc.AreaCode}).";
    }

    private async Task FetchSharedDataAsync()
    {
        _message = _error = null;
        _fetchingShared = true;
        try
        {
            _lastFetchSummary = await LinkService.FetchSharedVehiclesFromConnectedAsync(autoExcludeCrossProvince: true);
            _activeTab = "vehicles";
            _vehiclePage = 1;
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
            _message =
                $"Đã gọi {_lastFetchSummary.ConnectedAccountsCalled:N0} tài khoản đang Connect: " +
                $"thu về {_lastFetchSummary.RawVehiclesFetched:N0} bản ghi, gộp chuẩn Biển số - Số hiệu còn {_lastFetchSummary.UniqueVehiclesStored:N0} xe " +
                $"(đã loại bỏ {_lastFetchSummary.CrossProvinceDuplicatesRemoved:N0} bản ghi trùng liên tỉnh).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _fetchingShared = false;
        }
    }

    private async Task DeduplicateAndCleanAsync()
    {
        _message = _error = null;
        _loading = true;
        try
        {
            var (merged, autoExcluded) = await LinkService.DeduplicateAndCleanRegistryAsync();
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
            _message = $"Đã chuẩn hóa theo Biển số - Số hiệu: gộp {merged:N0} dòng trùng, tự động đánh dấu loại bỏ {autoExcluded:N0} xe thừa/ngoài vùng.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PushToOnlineCurrentAsync()
    {
        _message = _error = null;
        _loading = true;
        try
        {
            var pushed = await LinkService.PushCleanVehiclesToOnlineCurrentAsync(
                string.IsNullOrWhiteSpace(_areaFilter) ? null : _areaFilter);
            _message = $"Đã đồng bộ {pushed:N0} xe sạch (đã loại trùng) sang bảng GPS Online Current.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleExcludeAsync(SharedVehicleItemView row, bool exclude)
    {
        _message = _error = null;
        try
        {
            await LinkService.ToggleVehicleExcludeAsync(
                row.Id,
                exclude,
                exclude ? "Loại bỏ thông tin trùng/không cần thiết" : null);
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ChangePrimaryAreaAsync(SharedVehicleItemView row, string? newArea)
    {
        if (string.IsNullOrWhiteSpace(newArea)) return;
        _message = _error = null;
        try
        {
            await LinkService.UpdateVehiclePrimaryAreaAsync(row.Id, newArea);
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
            _message = $"Đã gán xe {row.PlateNo} ({row.VehicleNo}) về khu vực chuẩn {newArea}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteVehicleRowAsync(SharedVehicleItemView row)
    {
        _message = _error = null;
        try
        {
            await LinkService.DeleteVehicleRegistryRowAsync(row.Id);
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadVehiclesFirstPageAsync()
    {
        _vehiclePage = 1;
        _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
    }

    private async Task PrevVehiclePageAsync()
    {
        if (_registryPage is not null && _vehiclePage > 1)
        {
            _vehiclePage--;
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
        }
    }

    private async Task NextVehiclePageAsync()
    {
        if (_registryPage is not null && _vehiclePage < _registryPage.TotalPages)
        {
            _vehiclePage++;
            _registryPage = await LinkService.GetSharedVehiclesPageAsync(_vehiclePage, 100, _vehicleSearch, _filterMode, _areaFilter);
        }
    }

    private string GetQuickPassword(int id) => _quickPasswords.TryGetValue(id, out var v) ? v : string.Empty;
    private void SetQuickPassword(int id, string? value) => _quickPasswords[id] = value ?? string.Empty;

    private static string MaskSecret(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        if (value.Length <= 10) return "••••••••";
        return $"{value[..5]}••••{value[^4..]}";
    }

    private static string Shorten(string? value, int max)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        return value.Length <= max ? value : value[..max] + "…";
    }

    public void Dispose()
    {
        LinkService.Changed -= OnLinkServiceChanged;
        Ali.AuthChanged -= OnAliAuthChanged;
        AliWorker.StatusChanged -= OnWorkerChanged;
    }
}


