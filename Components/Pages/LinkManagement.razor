                            </label>
                            <label class="field" style="grid-column: 1 / -1">
                                <span>Device ID (Thông tin phụ định danh phiên)</span>
                                <input class="grid-input" @bind="_editor.DeviceId" />
                            </label>
                        </div>
                    </div>

                    <div class="link-form-group">
                        <h4>2. API Liên kết (data.skysoft.vn - GPS Online &amp; Cuốc khách)</h4>
                        <div class="link-form-grid three-cols">
                            <label class="field">
                                <span>API Username</span>
                                <input class="grid-input" @bind="_editor.ApiUserName" placeholder="ntbl_api / ntvl_api" />
                            </label>
                            <label class="field">
                                <span>API Key</span>
                                <input class="grid-input" @bind="_editor.ApiKey" placeholder="Key tạo chữ ký MD5" />
                            </label>
                            <label class="field">
                                <span>API Token @(_editor.KeepExistingApiToken ? "(Để trống nếu giữ nguyên)" : "")</span>
                                <input class="grid-input" type="password" @bind="_editor.ApiToken" placeholder="Nhập Token API..." />
                            </label>
                            <label class="field">
                                <span>API Base URL</span>
                                <input class="grid-input" @bind="_editor.ApiBaseUrl" />
                            </label>
                            <label class="field">
                                <span>Timeout (giây)</span>
                                <input class="grid-input" type="number" @bind="_editor.TimeoutSeconds" />
                            </label>
                            <label class="field">
                                <span>KM có khách tối thiểu</span>
                                <input class="grid-input" type="number" step="0.01" @bind="_editor.MinOccupiedKm" />
                            </label>
                        </div>
                    </div>

                    <div class="link-form-group">
                        <div class="link-form-grid two-cols">
                            <label class="field">
                                <span>Ghi chú phụ</span>
                                <input class="grid-input" @bind="_editor.Notes" placeholder="Ghi chú tài khoản / tỉnh..." />
                            </label>
                            <label class="remember-box" style="margin-top:20px">
                                <input type="checkbox" @bind="_editor.FilterCrossProvinceDuplicates" />
                                <span>Tự động loại bỏ xe trùng của tỉnh khác theo Biển số - Số hiệu</span>
