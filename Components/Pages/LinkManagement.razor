                    </div>

                    <div class="link-form-group">
                        <h4>1. Authentication App (go.skysoft.vn - Báo cáo đồng hồ)</h4>
                        <div class="link-form-grid three-cols">
                            <label class="field">
                                <span>Tài khoản (Username)</span>
                                <input class="grid-input" @bind="_editor.UserName" placeholder="namthangbl / namthangvl" />
                            </label>
                            <label class="field">
                                <span>Mật khẩu @(_editor.KeepExistingPassword ? "(Để trống nếu giữ nguyên)" : "")</span>
                                <input class="grid-input" type="password" @bind="_editor.Password" placeholder="Nhập mật khẩu SkySoft..." />
                            </label>
                            <label class="field">
                                <span>Base URL App</span>
                                <input class="grid-input" @bind="_editor.AppBaseUrl" />
                            </label>
                            <label class="field">
                                <span>Device Name</span>
                                <input class="grid-input" @bind="_editor.DeviceName" />
                            </label>
                            <label class="field">
                                <span>Device Brand</span>
                                <input class="grid-input" @bind="_editor.DeviceBrand" />
                            </label>
                            <label class="field">
                                <span>App OS / Version</span>
                                <div style="display:flex;gap:6px">
                                    <input class="grid-input" @bind="_editor.AppOs" placeholder="web" />
                                    <input class="grid-input" @bind="_editor.AppVersion" placeholder="1.0.58" />
