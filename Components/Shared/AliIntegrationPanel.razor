    private string? GetSelectedProvinceName()
    {
        if (string.IsNullOrWhiteSpace(_selectedProvince) || string.Equals(_selectedProvince, "ALL", StringComparison.OrdinalIgnoreCase))
            return null;
        return AliService.Provinces.FirstOrDefault(p => string.Equals(p.Code, _selectedProvince, StringComparison.OrdinalIgnoreCase))?.Name;
    }

    private List<AliOrder> FilterOrders()
    {
        IEnumerable<AliOrder> query = _orders;
